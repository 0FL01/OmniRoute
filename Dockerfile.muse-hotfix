ARG OMNIROUTE_IMAGE=diegosouzapw/omniroute:3.8.50-web
FROM ${OMNIROUTE_IMAGE}

USER root
RUN npm install -g --no-audit --no-fund @openai/codex@0.153.4

USER node
COPY --chown=node:node scripts/patch-muse-spark-1.3.mjs /tmp/patch-muse-spark-1.3.mjs
RUN node /tmp/patch-muse-spark-1.3.mjs && rm /tmp/patch-muse-spark-1.3.mjs
